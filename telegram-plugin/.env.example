# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated list of allowed Telegram chat IDs (leave empty to allow all)
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: bot polling interval in milliseconds (default: 1000)
TELEGRAM_POLL_INTERVAL=1000

# --- Auto-reply via Claude (optional) ---
# Get your API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Set to "true" to enable automatic Claude responses to incoming messages
TELEGRAM_AUTO_REPLY=true

# System prompt for the bot's personality (optional)
TELEGRAM_SYSTEM_PROMPT=You are a helpful assistant. Reply concisely and clearly.
